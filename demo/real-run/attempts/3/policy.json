{
  "version": 1,
  "workspace": "./workspace",
  "agent": {
    "maxSteps": 8,
    "maxRuntimeRetries": 1,
    "maxSeconds": 900
  },
  "approvalTimeoutSeconds": 900,
  "defaults": {
    "exec": "ask",
    "fs.read": "ask",
    "fs.write": "ask",
    "net.egress": "ask",
    "spend": "ask",
    "skill.save": "ask",
    "memory.write": "ask",
    "shell.exec": "ask",
    "host.exec": "ask",
    "schedule.create": "ask",
    "notify.owner": "allow",
    "browser.open": "ask",
    "browser.navigate": "allow",
    "browser.read": "allow",
    "browser.click": "allow",
    "browser.type": "ask",
    "agent.spawn": "ask",
    "skill.install": "ask",
    "mcp.call": "ask"
  },
  "rules": [
    {
      "class": "fs.read",
      "inWorkspace": true,
      "verdict": "allow"
    }
  ],
  "spend": {
    "maxPerActionCents": 0,
    "maxTotalCents": 0,
    "tokenMinutes": 60
  },
  "llmBudget": {
    "perRunCents": 100,
    "perDayCents": 500
  },
  "net": {
    "allowPrivateAddresses": false,
    "maxResponseBytes": 1000000,
    "timeoutSeconds": 20,
    "maxRedirects": 3
  },
  "sandbox": {
    "timeoutSeconds": 60,
    "maxOutputBytes": 256000,
    "memoryMb": 256,
    "maxBrokerCalls": 200,
    "mode": "auto",
    "requireContainer": false,
    "containerPidsLimit": 64
  },
  "llm": {
    "provider": "openai-compat",
    "baseUrl": "https://openrouter.ai/api/v1",
    "model": "anthropic/claude-sonnet-5.5",
    "smallModel": "anthropic/claude-haiku-5.5",
    "apiKeyEnv": "OPENROUTER_API_KEY",
    "prices": {
      "inputCentsPerMTok": 200,
      "outputCentsPerMTok": 1000
    },
    "maxResponseBytes": 2000000,
    "timeoutSeconds": 180
  },
  "search": {
    "provider": "none",
    "allowPrivateProvider": false,
    "maxResults": 10
  },
  "shell": {
    "network": "none",
    "timeoutSeconds": 60,
    "memoryMb": 256,
    "pidsLimit": 128,
    "maxOutputBytes": 64000,
    "workspace": {
      "maxFiles": 2000,
      "maxBytes": 32000000,
      "maxFileBytes": 8000000,
      "maxChangedFiles": 500,
      "maxDeletedFiles": 100
    }
  },
  "scheduled": {
    "maxRunsPerDay": 24,
    "maxLlmCentsPerDay": 50,
    "maxJobsTotal": 10,
    "defaultVerdictForAsk": "deny",
    "approvalTimeoutSeconds": 900,
    "minIntervalSeconds": 300,
    "maxRunSeconds": 600,
    "maxRunsPerJobPerDay": 24,
    "maxConsecutiveFailures": 5,
    "backoffBaseSeconds": 60,
    "timezone": "UTC"
  },
  "notify": {
    "maxPerHour": 4,
    "maxPerDay": 20,
    "maxChars": 1000
  },
  "browser": {
    "enabled": false,
    "allowedDomains": [],
    "maxActions": 20,
    "budgetCents": 0,
    "ttlSeconds": 900,
    "maxReadBytes": 65536,
    "maxLinks": 100,
    "timeoutSeconds": 70,
    "allowInput": false
  },
  "skillsRegistry": {
    "enabled": false,
    "maxBundleBytes": 524288,
    "maxFiles": 16,
    "maxFileBytes": 262144
  },
  "slack": {
    "enabled": false,
    "botTokenEnv": "SLACK_BOT_TOKEN",
    "signingSecretEnv": "SLACK_SIGNING_SECRET",
    "ownerIdEnv": "SLACK_OWNER_ID",
    "allowPublic": false
  },
  "discord": {
    "enabled": false,
    "botTokenEnv": "DISCORD_BOT_TOKEN",
    "publicKeyEnv": "DISCORD_PUBLIC_KEY",
    "applicationIdEnv": "DISCORD_APPLICATION_ID",
    "ownerIdEnv": "DISCORD_OWNER_ID",
    "allowPublic": false
  },
  "whatsapp": {
    "enabled": false,
    "tokenEnv": "WHATSAPP_TOKEN",
    "appSecretEnv": "WHATSAPP_APP_SECRET",
    "verifyTokenEnv": "WHATSAPP_VERIFY_TOKEN",
    "phoneNumberIdEnv": "WHATSAPP_PHONE_NUMBER_ID",
    "ownerNumberEnv": "WHATSAPP_OWNER_NUMBER",
    "graphApiVersion": "v25.0",
    "allowPublic": false
  },
  "signal": {
    "enabled": false,
    "bridgeUrl": "http://127.0.0.1:8080",
    "accountEnv": "SIGNAL_ACCOUNT",
    "ownerNumberEnv": "SIGNAL_OWNER_NUMBER",
    "allowPublic": false
  },
  "email": {
    "enabled": false,
    "imapPort": 993,
    "smtpPort": 465,
    "userEnv": "EMAIL_USER",
    "passwordEnv": "EMAIL_PASSWORD",
    "ownerAddressEnv": "EMAIL_OWNER_ADDRESS",
    "pollSeconds": 60,
    "allowPublic": false
  },
  "channels": {
    "port": 8787,
    "ownerChannel": "telegram",
    "timestampToleranceSeconds": 300,
    "maxBodyBytes": 262144
  },
  "subagents": {
    "enabled": false,
    "maxDepth": 1,
    "maxConcurrent": 2,
    "maxTotalPerRun": 4,
    "maxSeconds": 300,
    "maxActionsPerChild": 50,
    "maxLlmCentsPerChild": 10,
    "maxSpendCentsPerChild": 0,
    "maxResultChars": 4000
  },
  "mcp": {
    "enabled": false,
    "servers": []
  },
  "execOutputTaints": true
}