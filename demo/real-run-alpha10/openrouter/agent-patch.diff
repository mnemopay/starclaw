 });
+
+describe("verifyBundle duplicated-last-event tampering", () => {
+  function buildChain(count: number, sequence_start?: number) {
+    const chain = new AuditChain(sequence_start === undefined ? {} : { sequence_start });
+    for (let i = 0; i < count; i++) chain.emit("test.event", { i });
+    return chain;
+  }
+
+  it("rejects a bundle whose last event was duplicated (odd count)", () => {
+    const bundle = buildChain(3).toBundle();
+    expect(verifyBundle(bundle).ok).toBe(true);
+
+    const tampered = {
+      ...bundle,
+      events: [...bundle.events, bundle.events[bundle.events.length - 1]!],
+    };
+    // Same root: this is exactly why the Merkle check alone cannot catch it.
+    expect(tampered.merkle_root).toBe(bundle.merkle_root);
+    const result = verifyBundle(tampered);
+    expect(result.ok).toBe(false);
+    if (!result.ok) expect(result.reason).toBe("sequence_mismatch");
+  });
+
+  it("still verifies untampered bundles (odd, even, single, custom start)", () => {
+    for (const n of [1, 2, 3, 4, 5, 7]) {
+      expect(verifyBundle(buildChain(n).toBundle()).ok).toBe(true);
+    }
+    expect(verifyBundle(buildChain(3, 100).toBundle()).ok).toBe(true);
+  });
+});
