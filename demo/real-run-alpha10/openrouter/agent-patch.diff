diff --git a/tests/audit-chain.test.ts b/tests/audit-chain.test.ts
index 50b41fe..a3cdcb9 100644
--- a/tests/audit-chain.test.ts
+++ b/tests/audit-chain.test.ts
@@ -168,3 +168,33 @@ describe("AuditChain — file-backed", () => {
