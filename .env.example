# Copy to .env (never commit it). StarClaw's broker refuses to read .env* files.
GROQ_API_KEY=
# Optional front ends
STARCLAW_API_KEY=            # >= 16 chars; required by starclaw-server
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=           # numeric; required by starclaw-telegram
# TELEGRAM_ALLOW_PUBLIC=1    # let non-owners submit (tainted) goals
# STARCLAW_POLICY=./starclaw.policy.json
# STARCLAW_STATE_DIR=./.starclaw
