{
  "name": "starclaw",
  "version": "2.0.0-alpha.15",
  "description": "A governed autonomous AI agent: every action is policy-checked, approval-gated, spend-capped and written to a tamper-evident audit log.",
  "license": "Apache-2.0",
  "author": "J&B Enterprise LLC <info@getbizsuite.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnemopay/starclaw.git"
  },
  "homepage": "https://github.com/mnemopay/starclaw#readme",
  "bugs": {
    "url": "https://github.com/mnemopay/starclaw/issues"
  },
  "keywords": [
    "ai-agent",
    "agent-governance",
    "agent-security",
    "prompt-injection",
    "audit-log",
    "sandbox",
    "mnemopay"
  ],
  "main": "dist/index.js",
  "bin": {
    "starclaw": "dist/cli.js",
    "starclaw-telegram": "dist/telegram.js",
    "starclaw-server": "dist/server.js"
  },
  "files": [
    "dist",
    "public",
    "docker",
    "docs",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=25.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "cli": "node dist/cli.js",
    "server": "node dist/server.js",
    "doctor": "node dist/cli.js doctor",
    "demo": "node --import tsx demo/injection-demo.ts",
    "telegram": "node dist/telegram.js"
  },
  "dependencies": {
    "@mnemopay/sdk": "^1.16.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.5",
    "nodemailer": "^10.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
