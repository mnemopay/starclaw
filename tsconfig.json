{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@mnemopay/sdk/governance/audit-chain": ["node_modules/@mnemopay/sdk/dist/governance/audit-chain"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "demo/**/*"
  ]
}
